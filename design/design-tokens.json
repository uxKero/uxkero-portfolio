  },
  "border": {
    "rail": { "$value": "1px dashed #27272A", "$type": "border", "confidence": "high" },
    "nav-hairline": { "$value": "1px solid rgba(255,255,255,0.10)", "$type": "border", "confidence": "high" },
    "tick": { "$value": "1px solid #A1A1AA", "$type": "border", "confidence": "high" }
